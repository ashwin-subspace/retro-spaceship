<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A black, chrome-free theme. The window background matters: it is what the
      player sees for the fraction of a second before the first frame lands, and
      the platform default is a white flash.
    -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
